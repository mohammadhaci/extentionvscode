{
  "name": "agent-context-sync",
  "displayName": "Agent Context Sync",
  "description": "One rules file plus an auto-generated Django project map, kept in sync across CLAUDE.md, AGENTS.md and .github/copilot-instructions.md.",
  "version": "0.1.0",
  "publisher": "agent-context-sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/agent-context-sync"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agents",
    "claude",
    "codex",
    "copilot",
    "AGENTS.md",
    "CLAUDE.md",
    "django"
  ],
  "activationEvents": [
    "workspaceContains:.agent-context/rules.md",
    "onCommand:agent-context-sync.sync",
    "onCommand:agent-context-sync.openRules",
    "onCommand:agent-context-sync.installTool"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agent-context-sync.sync",
        "title": "Agent Context: Sync Now"
      },
      {
        "command": "agent-context-sync.openRules",
        "title": "Agent Context: Open Rules"
      },
      {
        "command": "agent-context-sync.installTool",
        "title": "Agent Context: Install CLI into Project"
      }
    ],
    "configuration": {
      "title": "Agent Context Sync",
      "properties": {
        "agentContextSync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Re-sync agent instruction files a few seconds after Python files or .agent-context/rules.md change (only in projects that have the rules file)."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".agent-context/config.json",
        "url": "./schema/config.schema.json"
      }
    ]
  },
  "scripts": {
    "vendor": "node scripts/vendor-analyzer.js",
    "precompile": "npm run vendor",
    "compile": "tsc -p ./",
    "watch": "npm run vendor && tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "prelint": "npm run vendor",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.12.0",
    "typescript": "^5.5.4"
  }
}
