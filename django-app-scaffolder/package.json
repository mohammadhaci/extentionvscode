{
  "name": "django-app-scaffolder",
  "displayName": "Django App Scaffolder",
  "description": "Create new Django apps by cloning an approved reference app, from VS Code or from coding agents (Claude Code, Codex, Copilot) via a bundled CLI and skill.",
  "version": "0.1.0",
  "publisher": "django-app-scaffolder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/django-app-scaffolder"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "django",
    "python",
    "scaffold",
    "template",
    "startapp",
    "agents",
    "claude",
    "codex",
    "copilot"
  ],
  "activationEvents": [
    "onCommand:django-app-scaffolder.newApp",
    "onCommand:django-app-scaffolder.setReference",
    "onCommand:django-app-scaffolder.checkApps",
    "onCommand:django-app-scaffolder.installAgentKit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "django-app-scaffolder.newApp",
        "title": "Django Scaffolder: New App from Reference"
      },
      {
        "command": "django-app-scaffolder.setReference",
        "title": "Django Scaffolder: Set as Reference App"
      },
      {
        "command": "django-app-scaffolder.checkApps",
        "title": "Django Scaffolder: Check Apps Against Reference"
      },
      {
        "command": "django-app-scaffolder.installAgentKit",
        "title": "Django Scaffolder: Install Agent Kit (CLI + Skill)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "django-app-scaffolder.newApp",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@10"
        },
        {
          "command": "django-app-scaffolder.setReference",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@11"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".django-scaffold.json",
        "url": "./schema/django-scaffold.schema.json"
      }
    ],
    "configuration": {
      "title": "Django App Scaffolder",
      "properties": {
        "djangoScaffolder.agentSkillRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".claude/skills",
            ".agents/skills",
            ".github/skills"
          ],
          "description": "Workspace-relative skill folders that receive the django-new-app skill (Claude Code, Codex, GitHub Copilot)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.12.0",
    "typescript": "^5.5.4"
  }
}
